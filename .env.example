# Copy to .env.local for development, or set in the Vercel dashboard. Nothing here is required to build.
# See docs/operations/DEPLOYMENT-AND-CONFIGURATION.md

# --- Site identity (set when the domain is confirmed) ---
NEXT_PUBLIC_SITE_URL=
# Keep false until the domain, legal pages and lead capture are reviewed. The site is noindex until this is true AND a URL is set.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Contact details shown on the site ---
NEXT_PUBLIC_CONTACT_EMAIL_GENERAL=
NEXT_PUBLIC_CONTACT_EMAIL_BUSINESS=
NEXT_PUBLIC_CONTACT_EMAIL_PRIVACY=

# --- Legal details (needed before launch; reviewed by a professional) ---
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_LEGAL_LAST_REVIEWED=

# --- Lead capture (choose at least one adapter; without one the forms say so honestly) ---
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
# Local development only: append leads to .data/leads.jsonl
LEAD_DEV_FILE=false

# --- Analytics (off unless a domain is set; loads only after consent) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Social profile URLs (leave empty until accounts exist) ---
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
